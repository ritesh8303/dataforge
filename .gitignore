.env
*.tfvars
!example.tfvars
.terraform/
terraform.tfstate
terraform.tfstate.backup
.terraform.lock.hcl
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.DS_Store
aws-keys-do-not-commit.txt

# Lambda build artifacts
*.zip
terraform/modules/lambda/*.zip

# Installed pip packages bundled into src/ for Lambda deployment
src/*.dist-info/
src/annotated_types/
src/certifi/
src/charset_normalizer/
src/idna/
src/pydantic/
src/pydantic_core/
src/requests/
src/typing_extensions.py
src/typing_inspection/
src/urllib3/
src/bin/
src/*.so
src/*.pyd

# Local pipeline outputs (small Gold aggregates in data/gold/ are committed intentionally)
data/bronze/
data/silver/
# Large row-level Gold CSVs: rewritten daily, would bloat git history ~6 MB/day
data/gold/all_jobs.csv
data/gold/expired_jobs.csv

# Temp debug files
event.json
out.txt
response.json
response2.json
tmp_*

# Terraform plan artifacts (binary, machine-specific — never commit)
*.tfplan

# Never vendor requests into Lambda zip (shadows AWSSDKPandas layer)
src/requests/
